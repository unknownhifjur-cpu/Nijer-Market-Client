# Leave empty when the customer app and API share one origin.
VITE_API_URL=https://nijermarket-server.onrender.com/api

# Optional pipe-separated location choices. Leave empty until the verified lists are available.
VITE_DELIVERY_VILLAGES=Chandranarayanpur|Tinshata Bighi|Notun Sikosti|Raipur|Mirjachak|Sahabanchak
VITE_DELIVERY_POST_OFFICES=Bedrabad|Baishnabnagar

# Optional map default center (latitude,longitude) for the configured delivery area.
# Leave empty until the actual delivery-area center has been verified.
VITE_DELIVERY_MAP_CENTER=
